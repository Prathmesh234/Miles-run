From 6ef4ae5581fa9e4558df22f39e92a24b67687a4b Mon Sep 17 00:00:00 2001
From: Prathmesh234 <ppbhatt500@gmail.com>
Date: Thu, 3 Sep 2026 17:40:50 -0700
Subject: [PATCH 1/2] Restore non-colocated PPO actor residency before weight
 broadcast

---
 train.py | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/train.py b/train.py
index c35458d..7811e37 100644
--- a/train.py
+++ b/train.py
@@ -20,6 +20,18 @@ from miles.utils.tracking_utils.tracking import finish_tracking, init_tracking
 logger = logging.getLogger(__name__)
 
 
+async def update_actor_weights(args, actor_model, **kwargs):
+    """Non-colocated PPO broadcasts from live actor tensors, not CPU backups."""
+    restore_residency = args.use_critic and args.offload_train and not args.colocate
+    if restore_residency:
+        await actor_model.onload()
+    try:
+        await actor_model.update_weights(**kwargs)
+    finally:
+        if restore_residency:
+            await actor_model.offload()
+
+
 async def train(args):
     assert not args.fully_async, "--fully-async requires the async driver: run train_async.py"
     configure_logger(args, source=MainProcessIdentity())
@@ -58,7 +70,7 @@ async def train(args):
         await rollout_manager.onload_weights.remote()
 
     # always update weight first so that sglang has the loaded weights from training.
-    await actor_model.update_weights()
+    await update_actor_weights(args, actor_model)
 
     if args.check_weight_update_equal:
         await rollout_manager.check_weights.remote(
@@ -148,7 +160,7 @@ async def train(args):
             await offload_train()
             if args.offload_rollout:
                 await rollout_manager.onload_weights.remote()
-        await actor_model.update_weights(rollout_id=rollout_id)
+        await update_actor_weights(args, actor_model, rollout_id=rollout_id)
         if args.offload_rollout:
             await rollout_manager.onload_kv.remote()
 
-- 

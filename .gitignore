# Local access configuration and secrets are never run evidence.
.env
.env.*
.kube/
*kubeconfig*
*.pem
*.key

# Python and platform caches.
__pycache__/
*.py[cod]
.venv/
.DS_Store

# Large/binary artifacts remain in the local and cluster archives.
*.tar
*.tar.gz
*.tgz
*.pt
*.pth
*.safetensors
*.distcp
checkpoints/
/converted-model/
tensorboard/
tensorboard_log/

# Upstream repositories are pinned, not vendored.
/miles/
/sglang-source/

# Generated longer-run source bundles stay local; publish their builder instead.
/run4-ppo-long/.work/
/run5-async-ppo-long/.work/

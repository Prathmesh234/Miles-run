# Local access configuration and secrets are never run evidence.
.env
.env.*
.kube/
*kubeconfig*
*.pem
*.key

# Python and platform caches.
__pycache__/
*.py[cod]
.venv/
.DS_Store

# Large/binary artifacts remain in the local and cluster archives.
*.tar
*.tar.gz
*.tgz
*.pt
*.pth
*.safetensors
*.distcp
checkpoints/
/converted-model/
tensorboard/
tensorboard_log/

# Upstream repositories are pinned, not vendored.
/miles/
/sglang-source/

# Dense publication only; complete evidence stays in archived run directories.
/.ppo-work/
/evidence-job-*/
/infra-preflight/
/results/*.png

index 0000000000000000000000000000000000000000..abcc7e2d445b02ea38b61b90f09680fcf6604917
--- /dev/null
+++ b/examples/experimental/openenv/posttrainingx_local_agent.py
@@ -0,0 +1,194 @@
+"""Clean local-file OpenEnv transport; Miles retains sampling and token tracing.
+
+No Verifiers upgrade, re-tokenization, host shell, or post-grading policy action.
+Operational errors stop this qualification run instead of becoming reward zero.
+"""
+import hashlib
+import json
+import math
+from functools import lru_cache
+from pathlib import Path
+
+
+@lru_cache(maxsize=1)
+def _qwen_comparator(model_path, template_path, template_kwargs):
+    # Optional heavy tokenizer imports are deferred until a truncated sample
+    # actually requires canonical replay. The launch recipe fixes these paths.
+    from miles.utils.processing_utils import load_tokenizer
+    from miles.utils.chat_template_utils.tito_tokenizer import Qwen36TITOTokenizer, resolve_fixed_chat_template
+
+    fixed_path, _ = resolve_fixed_chat_template('qwen36')
+    if not template_path or Path(template_path).read_bytes() != Path(fixed_path).read_bytes():
+        raise RuntimeError('Truncation comparison requires the resolved Qwen3.6 fixed renderer.')
+    tokenizer = load_tokenizer(model_path, chat_template_path=template_path, trust_remote_code=True)
+    return Qwen36TITOTokenizer(tokenizer, chat_template_kwargs=json.loads(template_kwargs))
+
+
+def _validate_truncated_tito(args, sample):
+    """Recheck an unfinished final message without inventing a sampled EOS.
+
+    Only the expected canonical sequence loses its single final closer. Native
+    tokens, logprobs, masks, rewards and the original mismatch are never edited.
+    Internal boundaries and non-assistant text must still compare successfully.
+    """
+    if (getattr(args, 'tito_model', None) != 'qwen36'
+            or sample.status.value != 'truncated'
+            or sample.metadata.get('agent_metrics', {}).get('end_reason') != 'length'
+            or {m.get('type') for m in sample.metadata['tito_session_mismatch']} != {'special_token_count'}):
+        raise RuntimeError('Strict native session-tokenization mismatch; unsupported truncation context.')
+    actual = sample.metadata.get('accumulated_token_ids')
+    if actual != sample.tokens:
+        raise RuntimeError('Truncated sample no longer equals native accumulated token IDs.')
+    tito = _qwen_comparator(args.hf_checkpoint, args.chat_template_path,
+                            json.dumps(args.apply_chat_template_kwargs or {}, sort_keys=True))
+    comparator = tito.create_comparator()
+    expected = tito.apply_chat_template(sample.metadata['messages'], add_generation_prompt=False, tokenize=True)
+    replayed = [m.to_dict() for m in comparator.compare_sequences(expected, actual)]
+    if replayed != sample.metadata['tito_session_mismatch']:
+        raise RuntimeError('Canonical replay did not reproduce the native mismatch exactly.')
+    end_id = tito.tokenizer.convert_tokens_to_ids('<|im_end|>')
+    while expected and expected[-1] in tito.trailing_token_ids:
+        expected.pop()
+    if not expected or expected[-1] != end_id or not actual or actual[-1] == end_id:
+        raise RuntimeError('Truncation discrepancy is not an unsampled final closer.')
+    compared = expected[:-1]
+    remaining = [m.to_dict() for m in comparator.compare_sequences(compared, actual)]
+    if any(m['type'] != 'assistant_text' for m in remaining):
+        raise RuntimeError('Strict TITO mismatch remains inside the unfinished message sequence.')
+    return {'contract': 'qwen36_length_limited_final_message_v1',
+            'renderer_sha256': hashlib.sha256(Path(args.chat_template_path).read_bytes()).hexdigest(),
+            'native_ids_sha256': hashlib.sha256(json.dumps(actual).encode()).hexdigest(),
+            'expected_comparison_ids_sha256': hashlib.sha256(json.dumps(compared).encode()).hexdigest(),
+            'omitted_expected_final_token_id': end_id, 'native_sample_changed': False,
+            'remaining_mismatches': remaining}
+
+
+async def run_episode(policy, model_name, messages, request_kwargs, metadata):
+    from openenv_agent_function import multi_turn, _shared_run_body
+    from posttrainingx_openenv_client import Action, LocalOpenEnvClient
+
+    attempts = metadata.get('posttrainingx_environment_attempts')
+
+    async def recorded_run_body(env_cls, context, body):
+        async def record_attempt(env):
+            try:
+                return await body(env)
+            finally:
+                if attempts is not None and env.episode_id is not None:
+                    attempts.append(
+                        {'episode_id': env.episode_id, 'task_id': env.task_id})
+        return await _shared_run_body(env_cls, context, record_attempt)
+
+    return await multi_turn(
+        {'env': LocalOpenEnvClient, 'action': Action}, policy, model_name,
+        messages, request_kwargs, metadata, run_body=recorded_run_body,
+    )
+
+
+async def run(base_url, prompt, request_kwargs=None, metadata=None, **kwargs):
+    from openenv_agent_function import run_for_training
+
+    context = dict(metadata or {}, posttrainingx_environment_attempts=[])
+    result = await run_for_training(base_url, prompt, request_kwargs, context, run_episode)
+    result = result if result is not None else {'reward': None, 'exit_status': 'operational_error'}
+    # Controller-generated IDs are accounting metadata, never policy messages.
+    result['posttrainingx_environment_attempts'] = context['posttrainingx_environment_attempts']
+    return result
+
+
+async def reward_func(args, samples, **kwargs):
+    def reward(sample):
+        value = sample.metadata.get('reward')
+        if value not in (0.0, 1.0) or sample.metadata.get('exit_status') not in ('completed', 'timeout'):
+            raise RuntimeError('Local environment returned no valid verdict; stopping rather than fabricating a negative reward.')
+        return float(value)
+    return [reward(s) for s in samples] if isinstance(samples, list) else reward(samples)
+
+
+def _validate_group(args, rows):
+    from miles.rollout.filter_hub.base_types import DynamicFilterOutput
+    from miles.utils.types import Sample
+    if len(rows) != args.n_samples_per_prompt or len({s.group_index for s in rows}) != 1:
+        raise RuntimeError('GRPO group cardinality or identity mismatch.')
+    for sample in rows:
+        if sample.status == Sample.Status.ABORTED:
+            raise RuntimeError('Aborted trajectory in synchronous qualification; preserving failure instead of silently retrying.')
+        if not sample.tokens or not all(type(t) is int and t >= 0 for t in sample.tokens):
+            raise RuntimeError('Missing native sampled token IDs.')
+        if (sample.rollout_log_probs is None or len(sample.rollout_log_probs) != sample.response_length
+                or not all(math.isfinite(p) for p in sample.rollout_log_probs)):
+            raise RuntimeError('Native response token/logprob accounting mismatch.')
+        if sample.loss_mask is None or len(sample.loss_mask) != sample.response_length or not any(sample.loss_mask):
+            raise RuntimeError('Missing native response loss mask.')
+        mismatches = sample.metadata.get('tito_session_mismatch')
+        if not isinstance(mismatches, list):
+            raise RuntimeError('Missing native session-tokenization verification.')
+        if any(m.get('type') != 'assistant_text' for m in mismatches):
+            sample.metadata['posttrainingx_tito_comparison'] = _validate_truncated_tito(args, sample)
+        # Qwen's processor returns {"images": None, "videos": None} even for
+        # text-only prompts. Match Miles' native media-presence semantics;
+        # never truth-test media tensors or discard actual media values.
+        if (sample.multimodal_inputs and any(v is not None for v in sample.multimodal_inputs.values())) or sample.multimodal_train_inputs:
+            raise RuntimeError('Text-only recipe received multimodal inputs.')
+    return DynamicFilterOutput(keep=True)
+
+
+def validate_group(args, samples, **kwargs):
+    """Keep native token evidence even when a qualification gate fails."""
+    import datetime
+    import hashlib
+    import json
+    import os
+    from pathlib import Path
+    import shutil
+    import tempfile
+    import uuid
+
+    rows = [s for item in samples for s in (item if isinstance(item, list) else [item])]
+    failure = None
+    try:
+        return _validate_group(args, rows)
+    except Exception as exc:
+        failure = f'{type(exc).__name__}: {exc}'
+        raise
+    finally:
+        if not args.dump_details:
+            raise RuntimeError('Qualification requires a run-owned dump_details directory.')
+        target = Path(args.dump_details) / 'qualification-groups'
+        target.mkdir(parents=True, exist_ok=True)
+        if shutil.disk_usage(target).free < 128 * 1024**2:
+            raise RuntimeError('Insufficient space to preserve native group evidence.')
+
+        def safe(value):
+            if isinstance(value, float) and not math.isfinite(value):
+                return {'nonfinite': str(value)}
+            if isinstance(value, dict):
+                return {str(k): safe(v) for k, v in value.items()}
+            if isinstance(value, (list, tuple)):
+                return [safe(v) for v in value]
+            if value is None or isinstance(value, (str, int, float, bool)):
+                return value
+            return {'unsupported_type': type(value).__name__}
+
+        keys = ('index', 'group_index', 'tokens', 'response_length', 'rollout_log_probs',
+                'loss_mask', 'weight_versions', 'reward', 'prompt', 'response', 'metadata')
+        payload = {'schema_version': 1, 'time': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                   'status': 'fail' if failure else 'ok', 'failure': failure,
+                   'scope': 'Pre-optimizer native sample gate; not proof of gradients or quality improvement.',
+                   'samples': [{**{key: safe(getattr(s, key)) for key in keys}, 'status': s.status.value,
+                                'raw_media_types': {k: None if v is None else type(v).__name__
+                                                    for k, v in (s.multimodal_inputs or {}).items()},
+                                'processed_media_keys': list((s.multimodal_train_inputs or {}).keys())}
+                               for s in rows]}
+        content = json.dumps(payload, sort_keys=True, allow_nan=False).encode()
+        name = 'group-' + uuid.uuid4().hex + '-' + hashlib.sha256(content).hexdigest() + '.json'
+        fd, temporary = tempfile.mkstemp(dir=target, prefix='.group-')
+        try:
+            with os.fdopen(fd, 'wb') as handle:
+                handle.write(content)
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(temporary, target / name)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)

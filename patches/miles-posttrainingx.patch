+import json
+import shlex
+
+import pytest
+
+from tests.fast.launch_scripts.py_harness import (
+    REPO_ROOT,
+    freeze_environment,
+    import_launch_script,
+    install_command_recorder,
+)
+
+
+def _launch(monkeypatch, **overrides):
+    freeze_environment(monkeypatch, hardware="B200")
+    recording = install_command_recorder(monkeypatch)
+    module = import_launch_script(REPO_ROOT / "scripts/run_qwen3_6_35b_a3b_posttrainingx.py")
+    args = module.ScriptArgs(**overrides)
+    module.execute(args)
+    command = next(c for c in recording.commands if "ray job submit" in c)
+    tokens = shlex.split(command)
+    env = json.loads(next(x.split("=", 1)[1] for x in tokens if x.startswith("--runtime-env-json=")))["env_vars"]
+    return args, recording.commands, tokens, env
+
+
+@pytest.mark.parametrize("layout,trainers,rollout_gpus", [("1t3r", 1, 24), ("2t2r", 2, 16), ("3t1r", 3, 8)])
+def test_async_splits_preserve_ep8_recipe_and_never_start_or_kill_shared_services(
+    monkeypatch, layout, trainers, rollout_gpus
+):
+    args, commands, tokens, env = _launch(monkeypatch, layout=layout)
+    value = lambda flag: tokens[tokens.index(flag) + 1]
+    assert value("--actor-num-nodes") == str(trainers)
+    assert value("--rollout-num-gpus") == str(rollout_gpus)
+    assert value("--rollout-num-gpus-per-engine") == value("--sglang-ep-size") == "8"
+    assert value("--tensor-model-parallel-size") == value("--context-parallel-size") == "1"
+    assert value("--pipeline-model-parallel-size") == value("--expert-tensor-parallel-size") == "1"
+    assert value("--expert-model-parallel-size") == "8"
+    assert value("--update-weight-transfer-mode") == "broadcast"
+    assert value("--max-weight-staleness") == value("--update-weights-interval") == "1"
+    assert value("--rollout-submission-granularity") == "sample"
+    assert "--fully-async" in tokens and "--colocate" not in tokens
+    assert any(x.endswith("/train_async.py") for x in tokens)
+    assert value("--tito-model") == "qwen36"
+    assert value("--custom-agent-function-path") == "openenv_agent_function.run"
+    assert value("--sglang-speculative-num-steps") == "2"
+    assert value("--sglang-speculative-num-draft-tokens") == "3"
+    assert value("--mtp-num-layers") == "1" and value("--mtp-loss-scaling-factor") == "0.2"
+    assert int(value("--rollout-batch-size")) * int(value("--n-samples-per-prompt")) == int(
+        value("--global-batch-size")
+    )
+    assert all(term not in "\n".join(commands) for term in ("pkill", "ray stop", "ray start", "DAYTONA"))
+    assert env["SGLANG_ENABLE_SPEC_V2"] == "1"
+    assert env["OPENENV_ENV_URL"] == args.openenv_env_url
+    assert value("--placement-host-order-file") == args.host_map
+
+
+def test_sync_validation_and_mtp_ablation_have_explicit_distinct_commands(monkeypatch):
+    _, _, tokens, env = _launch(monkeypatch, execution="sync", num_rollout=3, enable_mtp=False)
+    assert any(x.endswith("/train.py") for x in tokens)
+    assert "--fully-async" not in tokens and "--async-max-concurrent-samples" not in tokens
+    assert "--enable-mtp-training" not in tokens and "--sglang-speculative-algorithm" not in tokens
+    assert tokens[tokens.index("--num-rollout") + 1] == "3"
+    assert env["SGLANG_ENABLE_SPEC_V2"] == "0"
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        dict(num_nodes=3),
+        dict(num_gpus_per_node=4),
+        dict(hardware="H200"),
+        dict(global_batch_size=63),
+        dict(cleanup_existing_processes=True),
+        dict(external_ray=False),
+    ],
+)
+def test_invalid_profile_is_rejected_before_any_shell_command(monkeypatch, overrides):
+    freeze_environment(monkeypatch, hardware="B200")
+    recording = install_command_recorder(monkeypatch)
+    module = import_launch_script(REPO_ROOT / "scripts/run_qwen3_6_35b_a3b_posttrainingx.py")
+    with pytest.raises((ValueError, AssertionError)):
+        module.execute(module.ScriptArgs(**overrides))
+    assert recording.commands == []

+import json
+import shlex
+import hashlib
+import importlib.util
+import copy
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from tests.fast.launch_scripts.py_harness import (
+    REPO_ROOT,
+    freeze_environment,
+    import_launch_script,
+    install_command_recorder,
+)
+
+
+def _local_group(tmp_path):
+    from miles.utils.types import Sample
+    source = REPO_ROOT / 'examples/experimental/openenv/posttrainingx_local_agent.py'
+    spec = importlib.util.spec_from_file_location('local_gate_test', source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    samples = [Sample(index=i, group_index=0, tokens=[1, 2], response_length=1,
+                      rollout_log_probs=[-0.5], loss_mask=[1], reward=1.0,
+                      metadata={'tito_session_mismatch': []},
+                      multimodal_inputs={'images': None, 'videos': None},
+                      status=Sample.Status.COMPLETED) for i in range(8)]
+    return module, SimpleNamespace(n_samples_per_prompt=8, dump_details=str(tmp_path)), samples
+
+
+def test_local_text_gate_accepts_qwen_null_media_and_preserves_native_ids(tmp_path):
+    module, args, samples = _local_group(tmp_path)
+    assert module.validate_group(args, samples).keep
+    path, = (tmp_path / 'qualification-groups').glob('*.json')
+    data = json.loads(path.read_text())
+    assert data['status'] == 'ok' and len(data['samples']) == 8
+    assert data['samples'][0]['tokens'] == [1, 2]
+    assert data['samples'][0]['raw_media_types'] == {'images': None, 'videos': None}
+    assert hashlib.sha256(path.read_bytes()).hexdigest() in path.name
+
+
+@pytest.mark.parametrize('fault', ['raw_media', 'processed_media', 'nan_logprob', 'wrong_group', 'missing_mask',
+                                  'missing_tito', 'special_token_count', 'special_token_type', 'non_assistant_text'])
+def test_local_group_failures_keep_evidence_and_do_not_relax_other_gates(tmp_path, fault):
+    module, args, samples = _local_group(tmp_path)
+    first = samples[0]
+    if fault == 'raw_media':
+        first.multimodal_inputs['images'] = object()
+    elif fault == 'processed_media':
+        first.multimodal_train_inputs = {'pixel_values': object()}
+    elif fault == 'nan_logprob':
+        first.rollout_log_probs = [float('nan')]
+    elif fault == 'wrong_group':
+        first.group_index = 1
+    elif fault == 'missing_mask':
+        first.loss_mask = None
+    elif fault == 'missing_tito':
+        first.metadata.pop('tito_session_mismatch')
+    else:
+        first.status = type(first.status).TRUNCATED
+        first.metadata['tito_session_mismatch'] = [{'type': fault}]
+    with pytest.raises(RuntimeError):
+        module.validate_group(args, samples)
+    path, = (tmp_path / 'qualification-groups').glob('*.json')
+    data = json.loads(path.read_text())
+    assert data['status'] == 'fail' and data['failure']
+    if fault == 'nan_logprob':
+        assert data['samples'][0]['rollout_log_probs'] == [{'nonfinite': 'nan'}]
+
+
+@pytest.mark.parametrize('fault', [None, 'missing_internal_end', 'changed_system', 'extra_end', 'not_length'])
+def test_unfinished_message_comparison_never_rewrites_samples_or_hides_internal_errors(tmp_path, monkeypatch, fault):
+    # Load the actual dependency-free comparator without importing the HF
+    # package facade; this launcher suite deliberately has no HF environment.
+    source = REPO_ROOT / 'miles/utils/chat_template_utils/token_seq_comparator.py'
+    spec = importlib.util.spec_from_file_location('local_comparator_test', source)
+    comparator_module = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, spec.name, comparator_module)
+    spec.loader.exec_module(comparator_module)
+    TokenSeqComparator = comparator_module.TokenSeqComparator
+
+    module, args, samples = _local_group(tmp_path)
+    mapping = {1: '<|im_start|>', 2: '<|im_end|>', 3: '\n', 10: 'system\nx', 11: 'assistant\ny', 12: 'corrupted'}
+    tokenizer = SimpleNamespace(all_special_ids=[1, 2], decode=lambda ids, **kwargs: ''.join(mapping[i] for i in ids),
+                                convert_tokens_to_ids=lambda text: 2)
+    comparator = TokenSeqComparator(tokenizer, '<|im_start|>assistant', trim_trailing_ids={3})
+    expected = [1, 10, 2, 3, 1, 11, 2, 3]
+    tito = SimpleNamespace(tokenizer=tokenizer, trailing_token_ids={3}, create_comparator=lambda: comparator,
+                           apply_chat_template=lambda *a, **k: list(expected))
+    def configured_comparator(model_path, template_path, template_kwargs):
+        assert json.loads(template_kwargs) == {'preserve_thinking': True}
+        return tito
+    monkeypatch.setattr(module, '_qwen_comparator', configured_comparator)
+    args.tito_model = 'qwen36'
+    args.hf_checkpoint = '/unused'
+    args.chat_template_path = str(tmp_path / 'template.jinja')
+    # Use Miles' actual parsed argument, with no invented compatibility alias.
+    args.apply_chat_template_kwargs = {'preserve_thinking': True}
+    (tmp_path / 'template.jinja').write_text('fixture')
+    sample = samples[0]
+    sample.status = type(sample.status).TRUNCATED
+    sample.tokens = [1, 10, 2, 3, 1, 11]
+    if fault == 'missing_internal_end':
+        sample.tokens.pop(2)
+    elif fault == 'changed_system':
+        sample.tokens[1] = 12
+    elif fault == 'extra_end':
+        sample.tokens.insert(2, 2)
+    sample.metadata = {'agent_metrics': {'end_reason': 'stop' if fault == 'not_length' else 'length'},
+                       'accumulated_token_ids': list(sample.tokens), 'messages': [],
+                       'tito_session_mismatch': [m.to_dict() for m in comparator.compare_sequences(expected, sample.tokens)]}
+    before = copy.deepcopy(sample.to_dict())
+    if fault:
+        with pytest.raises(RuntimeError):
+            module._validate_truncated_tito(args, sample)
+    else:
+        result = module._validate_truncated_tito(args, sample)
+        assert result['remaining_mismatches'] == [] and result['native_sample_changed'] is False
+    assert sample.to_dict() == before
+
+
+def _launch(monkeypatch, **overrides):
+    freeze_environment(monkeypatch, hardware="B200")
+    recording = install_command_recorder(monkeypatch)
+    module = import_launch_script(REPO_ROOT / "scripts/run_qwen3_6_35b_a3b_posttrainingx.py")
+    args = module.ScriptArgs(**overrides)
+    module.execute(args)
+    command = next(c for c in recording.commands if "ray job submit" in c)
+    tokens = shlex.split(command)
+    env = json.loads(next(x.split("=", 1)[1] for x in tokens if x.startswith("--runtime-env-json=")))["env_vars"]
+    return args, recording.commands, tokens, env
+
+
+@pytest.mark.parametrize("layout,trainers,rollout_gpus", [("1t3r", 1, 24), ("2t2r", 2, 16), ("3t1r", 3, 8)])
+def test_async_splits_preserve_ep8_recipe_and_never_start_or_kill_shared_services(
+    monkeypatch, layout, trainers, rollout_gpus
+):
+    args, commands, tokens, env = _launch(monkeypatch, layout=layout, global_batch_size=96, rollout_batch_size=12)
+    value = lambda flag: tokens[tokens.index(flag) + 1]
+    assert value("--actor-num-nodes") == str(trainers)
+    assert value("--rollout-num-gpus") == str(rollout_gpus)
+    assert value("--rollout-num-gpus-per-engine") == value("--sglang-ep-size") == "8"
+    assert value("--sglang-moe-runner-backend") == "triton"
+    assert env["SGLANG_OPT_FUSE_SWIGLU_INTERLEAVED"] == "0"
+    assert value("--tensor-model-parallel-size") == value("--context-parallel-size") == "1"
+    assert value("--pipeline-model-parallel-size") == value("--expert-tensor-parallel-size") == "1"
+    assert value("--expert-model-parallel-size") == "8"
+    assert value("--update-weight-transfer-mode") == "broadcast"
+    assert value("--max-weight-staleness") == value("--update-weights-interval") == "1"
+    assert value("--rollout-submission-granularity") == "sample"
+    assert "--fully-async" in tokens and "--colocate" not in tokens
+    assert any(x.endswith("/train_async.py") for x in tokens)
+    assert value("--tito-model") == "qwen36"
+    assert value("--custom-agent-function-path") == "posttrainingx_local_agent.run"
+    assert value("--custom-rm-path") == "posttrainingx_local_agent.reward_func"
+    assert value("--dynamic-sampling-filter-path") == "posttrainingx_local_agent.validate_group"
+    assert value("--sglang-speculative-num-steps") == "2"
+    assert value("--sglang-speculative-num-draft-tokens") == "3"
+    assert value("--mtp-num-layers") == "1" and value("--mtp-loss-scaling-factor") == "0.2"
+    assert int(value("--rollout-batch-size")) * int(value("--n-samples-per-prompt")) == int(
+        value("--global-batch-size")
+    )
+    assert all(term not in "\n".join(commands) for term in ("pkill", "ray stop", "ray start", "DAYTONA"))
+    assert "SGLANG_ENABLE_SPEC_V2" not in env
+    assert env["OPENENV_ENV_URL"] == args.openenv_env_url
+    assert value("--placement-host-order-file") == args.host_map
+
+
+def test_sync_validation_and_mtp_ablation_have_explicit_distinct_commands(monkeypatch):
+    _, _, tokens, env = _launch(monkeypatch, execution="sync", num_rollout=3, enable_mtp=False)
+    assert any(x.endswith("/train.py") for x in tokens)
+    assert "--fully-async" not in tokens and "--async-max-concurrent-samples" not in tokens
+    assert "--enable-mtp-training" not in tokens and "--sglang-speculative-algorithm" not in tokens
+    assert tokens[tokens.index("--num-rollout") + 1] == "3"
+    assert "SGLANG_ENABLE_SPEC_V2" not in env
+
+
+def test_reference_batch_and_explicit_pinned_paths_are_preserved(monkeypatch):
+    _, _, tokens, _ = _launch(
+        monkeypatch, hf_checkpoint="/shared/pinned model revision", ref_load="/shared/converted-v2"
+    )
+    assert tokens[tokens.index("--global-batch-size") + 1] == "64"
+    assert tokens[tokens.index("--rollout-batch-size") + 1] == "8"

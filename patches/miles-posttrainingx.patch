@@ -0,0 +1,86 @@
+"""Actual Sample and data-source round trips; no models, tokenizers, or GPUs."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from miles.rollout.checkpointed_data_source import CheckpointedRolloutDataSource
+from miles.rollout.data_source import pop_first
+from miles.utils.types import Sample
+
+
+def source(tmp_path):
+    prompt = tmp_path / "prompts.jsonl"
+    if not prompt.exists():
+        prompt.write_text('{"prompt":"fixture"}\n')
+    result = object.__new__(CheckpointedRolloutDataSource)
+    result.args = SimpleNamespace(rollout_global_dataset=True, rollout_shuffle=False, rollout_seed=17,
+        prompt_data=str(prompt), n_samples_per_prompt=2, save=str(tmp_path), load=str(tmp_path))
+    result.sample_offset, result.epoch_id = 3, 2
+    result.sample_group_index, result.sample_index = 6, 12
+    result.metadata = {"fixture": ["ordered", 7]}
+    result.buffer_filter = pop_first
+    result.dataset = None
+    result.buffer = [[Sample(index=i, group_index=5, tokens=[11, 22], response_length=1,
+        rollout_log_probs=[-0.25], loss_mask=[1], reward=float(i % 2), weight_versions=[3],
+        metadata={"posttrainingx_environment_attempts": [{"episode_id": f"e{i}"}],
+                  "tensor_fixture": torch.tensor([i], dtype=torch.int64)}) for i in (10, 11)]]
+    return result
+
+
+def test_cursor_buffer_native_fields_and_next_consumption_survive(tmp_path):
+    original = source(tmp_path)
+    original.save(4)
+    restored = source(tmp_path)
+    restored.sample_offset, restored.sample_index, restored.buffer = 0, 0, []
+    restored.load(4)
+    assert (restored.sample_offset, restored.epoch_id, restored.sample_group_index, restored.sample_index) == (3, 2, 6, 12)
+    assert restored.metadata == original.metadata
+    assert restored.get_buffer_length() == 1
+    for before, after in zip(original.get_samples(1)[0], restored.get_samples(1)[0], strict=True):
+        left, right = before.to_dict(), after.to_dict()
+        lt, rt = left["metadata"].pop("tensor_fixture"), right["metadata"].pop("tensor_fixture")
+        assert lt.dtype == rt.dtype == torch.int64 and torch.equal(lt, rt)
+        assert left == right
+    assert original.get_buffer_length() == restored.get_buffer_length() == 0
+
+
+@pytest.mark.parametrize("mutation", ["missing_manifest", "corrupt_payload", "changed_tasks", "changed_seed"])
+def test_restore_rejects_corruption_and_contract_drift_without_mutation(tmp_path, mutation):
+    original = source(tmp_path)
+    original.save(4)
+    restored = source(tmp_path)
+    restored.sample_index = 99
+    path = tmp_path / "rollout/posttrainingx_source_state_4.pt"
+    if mutation == "missing_manifest":
+        path.with_suffix(".json").unlink()
+    elif mutation == "corrupt_payload":
+        path.write_bytes(path.read_bytes() + b"corrupt")
+    elif mutation == "changed_tasks":
+        (tmp_path / "prompts.jsonl").write_text("changed order\n")
+    else:
+        restored.args.rollout_seed += 1
+    with pytest.raises((ValueError, FileNotFoundError)):
+        restored.load(4)
+    assert restored.sample_index == 99 and restored.get_buffer_length() == 1
+
+
+def test_explicit_fresh_start_and_duplicate_snapshot_guard(tmp_path):
+    original = source(tmp_path)
+    original.load(-1)
+    original.save(4)
+    with pytest.raises(FileExistsError):
+        original.save(4)
+    with pytest.raises(FileNotFoundError):
+        original.load(3)
+    with pytest.raises(ValueError):
+        original.load(None)
+
+
+def test_empty_buffer_is_explicitly_restored(tmp_path):
+    original = source(tmp_path)
+    original.buffer = []
+    original.save(4)
+    restored = source(tmp_path)
+    restored.load(4)
+    assert restored.buffer == []

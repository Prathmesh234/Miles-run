diff --git a/miles/rollout/checkpointed_data_source.py b/miles/rollout/checkpointed_data_source.py
new file mode 100644
index 000000000..328618753
--- /dev/null
+++ b/miles/rollout/checkpointed_data_source.py
@@ -0,0 +1,116 @@
+"""Strict opt-in persistence for the dataset cursor and recycled prompt buffer.
+
+This is one component of resume, not a checkpoint of the fully-async producer,
+completed-group queue, optimizer, or broadcast policy version. Those must be
+coordinated by the caller before claiming an end-to-end resumable checkpoint.
+"""
+
+import hashlib
+import io
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+import torch
+
+from miles.rollout.data_source import RolloutDataSourceWithBuffer
+from miles.utils.types import Sample
+
+_CURSOR_FIELDS = ("sample_offset", "epoch_id", "sample_group_index", "sample_index", "metadata")
+_SCHEMA_VERSION = 1
+
+
+def _contract(args):
+    path = Path(args.prompt_data)
+    return {
+        "prompt_data_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+        "n_samples_per_prompt": args.n_samples_per_prompt,
+        "rollout_seed": args.rollout_seed,
+        "rollout_shuffle": args.rollout_shuffle,
+    }
+
+
+def _atomic_bytes(path: Path, content: bytes) -> None:
+    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix="." + path.name)
+    try:
+        with os.fdopen(fd, "wb") as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+        # No replacement of an existing snapshot or symlink.
+        os.link(temporary, path)
+        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    finally:
+        os.unlink(temporary)
+
+
+class CheckpointedRolloutDataSource(RolloutDataSourceWithBuffer):
+    """Opt in through --data-source-path; refuse legacy or partial restores."""
+
+    def save(self, rollout_id):
+        if not self.args.rollout_global_dataset or rollout_id < 0:
+            raise ValueError("A nonnegative rollout ID and global dataset are required.")
+        directory = Path(self.args.save) / "rollout"
+        directory.mkdir(parents=True, exist_ok=True)
+        if any(path.is_symlink() for path in (directory, *directory.parents)):
+            raise ValueError("Checkpoint paths may not contain symlinks.")
+        if shutil.disk_usage(directory).free < 256 * 1024**2:
+            raise ValueError("Rollout checkpoint requires a 256 MiB free-space reserve.")
+        payload = {"schema_version": _SCHEMA_VERSION, "rollout_id": rollout_id, "contract": _contract(self.args),
+                   "cursor": {key: getattr(self, key) for key in _CURSOR_FIELDS},
+                   "buffer": [[sample.to_dict() for sample in group] for group in self.buffer]}
+        # torch serialization preserves native tensor dtypes and all Sample fields.
+        # Only trusted run-owned bytes are loaded, after checksum verification.
+        stream = io.BytesIO()
+        torch.save(payload, stream)
+        content = stream.getvalue()
+        if shutil.disk_usage(directory).free - len(content) < 256 * 1024**2:
+            raise ValueError("Serialized rollout state would consume the free-space reserve.")
+        path = directory / f"posttrainingx_source_state_{rollout_id}.pt"
+        _atomic_bytes(path, content)
+        manifest = {"schema_version": _SCHEMA_VERSION, "rollout_id": rollout_id,
+                    "sha256": hashlib.sha256(content).hexdigest(), "bytes": len(content),
+                    "buffer_groups": len(self.buffer)}
+        _atomic_bytes(path.with_suffix(".json"), (json.dumps(manifest, sort_keys=True) + "\n").encode())
+
+    def load(self, rollout_id=None):
+        if rollout_id == -1:
+            return  # Explicit fresh-model boundary used by create_training_models.
+        if rollout_id is None or rollout_id < 0 or not self.args.load:
+            raise ValueError("Resume requires an explicit checkpoint and rollout ID.")
+        path = Path(self.args.load) / "rollout" / f"posttrainingx_source_state_{rollout_id}.pt"
+        manifest_path = path.with_suffix(".json")
+        if any(p.is_symlink() for p in (path, manifest_path, *path.parents)):
+            raise ValueError("Linked rollout checkpoints are not accepted.")
+        manifest = json.loads(manifest_path.read_text())
+        content = path.read_bytes()
+        if (manifest["sha256"] != hashlib.sha256(content).hexdigest() or manifest["bytes"] != len(content)
+                or manifest["schema_version"] != _SCHEMA_VERSION or manifest["rollout_id"] != rollout_id):
+            raise ValueError("Rollout checkpoint manifest or payload checksum differs.")
+        state = torch.load(io.BytesIO(content), map_location="cpu", weights_only=False)
+        if (state["schema_version"] != _SCHEMA_VERSION or state["rollout_id"] != rollout_id
+                or state["contract"] != _contract(self.args)):
+            raise ValueError("Rollout checkpoint identity or dataset contract differs.")
+        cursor = state["cursor"]
+        if set(cursor) != set(_CURSOR_FIELDS) or any(
+            type(cursor[key]) is not int or cursor[key] < 0 for key in _CURSOR_FIELDS if key != "metadata"
+        ):
+            raise ValueError("Rollout cursor schema or counters are invalid.")
+        buffer = [[Sample.from_dict(row) for row in group] for group in state["buffer"]]
+        if manifest["buffer_groups"] != len(buffer) or any(
+            len(group) != self.args.n_samples_per_prompt for group in buffer
+        ):
+            raise ValueError("Recycled prompt group cardinality differs.")
+        # Mutate only after the complete payload has validated. Failed restore
+        # must not leave partially updated counters or silently empty a buffer.
+        if self.args.rollout_shuffle:
+            self.dataset.shuffle(cursor["epoch_id"])
+        for key, value in cursor.items():
+            setattr(self, key, value)
+        self.buffer = buffer

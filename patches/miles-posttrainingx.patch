@@ -0,0 +1,56 @@
+"""Opt-in terminal release of pinned weight backups, with durable receipts.
+
+Do not use this between optimizer steps. It does not offload or modify live
+model, optimizer or scheduler tensors, nor destroy CUDA/NCCL contexts.
+"""
+
+import time
+
+import torch
+
+from miles.rollout.trajectory_journal import record_lifecycle
+
+
+def release_pinned_backups(backuper) -> dict:
+    torch.cuda.synchronize()
+    keys = ("active_bytes.current", "allocated_bytes.current")
+    before = torch.cuda.memory.host_memory_stats()
+    started = time.monotonic()
+    tensor_bytes = backuper.close()
+    # Pinned caches are distinct from torch.cuda.empty_cache(). This explicit
+    # native API was qualified in the pinned image; missing support must fail.
+    torch._C._host_emptyCache()
+    after = torch.cuda.memory.host_memory_stats()
+    if tensor_bytes:
+        for key in keys:
+            if after[key] < 0 or before[key] - after[key] < tensor_bytes:
+                raise RuntimeError(f"Pinned backup release accounting failed for {key}")
+    return dict(
+        tensor_bytes=tensor_bytes,
+        duration_s=time.monotonic() - started,
+        before={key: before[key] for key in keys if key in before},
+        after={key: after[key] for key in keys if key in after},
+    )
+
+
+def release_and_record(args, backuper, *, rank: int, policy_version: int | None) -> dict:
+    if not args.rollout_journal_dir:
+        raise ValueError("Terminal host cleanup requires a private lifecycle journal")
+    identity = dict(rank=rank, policy_version=policy_version)
+    record_lifecycle(args, "training_host_cleanup_started", **identity)
+    try:
+        result = release_pinned_backups(backuper)
+    except Exception as exc:
+        record_lifecycle(args, "training_host_cleanup_failed", error=str(exc), **identity)
+        raise
+    record_lifecycle(args, "training_host_cleanup_completed", **identity, **result)
+    return result
+
+
+async def finish_training_resources(args, actor_model, critic_model) -> None:
+    """Called only after the driver's normal save/update/evaluation/dispose path."""
+    if not getattr(args, "release_pinned_backups_on_exit", False):
+        return
+    await actor_model.release_pinned_weight_backups()
+    if critic_model is not None:
+        await critic_model.release_pinned_weight_backups()

@@ -0,0 +1,94 @@
+"""Validate and record an explicit whole-node placement without GPU imports."""
+
+import datetime
+import ipaddress
+import json
+import os
+from pathlib import Path
+import tempfile
+
+
+def load_host_map(path, *, num_gpus, trainer_gpus, gpus_per_node):
+    data = json.loads(Path(path).read_text())
+    if data.get("schema_version") != 1:
+        raise ValueError("The host map requires schema_version=1.")
+    nodes = data["nodes"]
+    if not nodes or len(nodes) * gpus_per_node != num_gpus or trainer_gpus % gpus_per_node:
+        raise ValueError("Host map size does not match the whole-node allocation.")
+    ips, names, uuids = set(), set(), set()
+    for index, node in enumerate(nodes):
+        ip = str(ipaddress.IPv4Address(node["ray_node_ip"]))
+        expected_role = "trainer" if index * gpus_per_node < trainer_gpus else "rollout"
+        if node.get("role") != expected_role:
+            raise ValueError("Host map must list all trainer nodes before rollout nodes.")
+        if ip in ips or node["hostname"] in names:
+            raise ValueError("Host map contains duplicate hosts or addresses.")
+        expected_uuids = node["gpu_uuids"]
+        if len(expected_uuids) != gpus_per_node or len(set(expected_uuids)) != gpus_per_node:
+            raise ValueError("Each host must enumerate its distinct physical GPU UUIDs.")
+        if uuids.intersection(expected_uuids) or any(not u.startswith("GPU-") for u in expected_uuids):
+            raise ValueError("Physical GPU UUIDs are duplicated or invalid.")
+        ips.add(ip)
+        names.add(node["hostname"])
+        uuids.update(expected_uuids)
+    return nodes
+
+
+def placement_bundles(nodes, ray_nodes, *, gpus_per_node):
+    alive = {n["NodeManagerAddress"]: n for n in ray_nodes if n.get("Alive") and n.get("Resources", {}).get("GPU", 0)}
+    if set(alive) != {n["ray_node_ip"] for n in nodes}:
+        raise ValueError("Ray GPU hosts do not exactly match this allocation's host map.")
+    bundles = []
+    for node in nodes:
+        ip = node["ray_node_ip"]
+        resource = "node:" + ip
+        resources = alive[ip]["Resources"]
+        if resources.get("GPU") != gpus_per_node or resources.get(resource, 0) < gpus_per_node * 0.01:
+            raise ValueError("Ray does not advertise the expected GPUs and node-affinity resource.")
+        bundles.extend({"GPU": 1, "CPU": 1, resource: 0.01} for _ in range(gpus_per_node))
+    return bundles
+
+
+def validate_observed_placement(nodes, identities, *, gpus_per_node):
+    if len(identities) != len(nodes) * gpus_per_node:
+        raise ValueError("The placement probe returned the wrong GPU count.")
+    records = []
+    for index, node in enumerate(nodes):
+        block = identities[index * gpus_per_node : (index + 1) * gpus_per_node]
+        if any(row["ray_node_ip"] != node["ray_node_ip"] for row in block):
+            raise ValueError("A GPU bundle escaped its requested physical node.")
+        if {row["gpu_uuid"] for row in block} != set(node["gpu_uuids"]):
+            raise ValueError("Observed physical GPU UUIDs differ from the frozen host map.")
+        for offset, row in enumerate(block):
+            records.append(
+                dict(
+                    row,
+                    bundle_index=index * gpus_per_node + offset,
+                    declared_hostname=node["hostname"],
+                    role=node["role"],
+                )
+            )
+    return records
+
+
+def write_placement_record(path, records, *, placement_group_id):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    data = {
+        "schema_version": 1,
+        "time": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+        "placement_group_id": placement_group_id,
+        "bundles": records,
+        "scope": "Physical placement probes. Training and engine actor identities must also be collected during execution.",
+    }
+    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".placement-")
+    try:
+        with os.fdopen(fd, "w") as f:
+            json.dump(data, f, indent=2, sort_keys=True)
+            f.write("\n")
+            f.flush()
+            os.fsync(f.fileno())
+        # The hard link publishes a complete file without replacing earlier evidence.
+        os.link(temporary, path)
+    finally:
+        os.unlink(temporary)

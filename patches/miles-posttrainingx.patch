+"""Qwen3.6-35B-A3B GRPO with local OpenEnv tasks on four B200 nodes.
+
+Requires pinned HF and converted checkpoints, clean training prompt data, a
+validated local OpenEnv endpoint, and a pre-existing run-owned Ray cluster.
+The site adapter owns allocation, image pins, GPU reconciliation, and cleanup.
+Terminal-Bench is evaluation-only and is not downloaded by this launcher.
+
+Args:
+    layout: Whole-node trainer/rollout split: 1t3r, 2t2r, or 3t1r.
+    execution: sync uses train.py for correctness; async uses train_async.py.
+    host_map: JSON placement map, in trainer-first then rollout node order.
+    num_rollout: Optimizer-step budget when the one-step invariant holds.
+
+Example:
+    python scripts/run_qwen3_6_35b_a3b_posttrainingx.py --hardware B200 \
+        --output-dir /shared/posttrainingx/runs/vultr-b200-slurm \
+        --run-id example --layout 2t2r --num-rollout 400
+
+This launcher defines the recipe. It does not assert that environment, resume,
+gradient, placement, or quality gates have passed.
+"""
+
+import shlex
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+import typer
+
+import miles.utils.external_utils.command_utils as U
+
+
+@dataclass
+class ScriptArgs(U.ExecuteTrainConfig):
+    num_nodes: int = 4
+    external_ray: bool = True
+    cleanup_existing_processes: bool = False
+    hardware: Literal["auto", "B200"] = "auto"
+    num_gpus_per_node: int = 8
+    run_id: str = U.create_run_id()
+    layout: Literal["1t3r", "2t2r", "3t1r"] = "2t2r"
+    execution: Literal["sync", "async"] = "async"
+    model_name: str = "Qwen3.6-35B-A3B"
+    megatron_model_type: str = "qwen3.6-35B-A3B"
+    model_dir: str = "/root/models"
+    megatron_path: str = "/root/Megatron-LM"
+    prompt_data: str = ""
+    host_map: str = ""
+    placement_record_path: str = ""
+    load_from: str = ""
+    num_rollout: int = 400
+    save_interval: int = 50
+    rollout_batch_size: int = 8
+    n_samples_per_prompt: int = 8
+    global_batch_size: int = 64
+    seed: int = 1234
+    max_tokens_per_gpu: int = 8192
+    max_seq_len: int = 65536
+    rollout_max_response_len: int = 8192
+    async_max_concurrent_samples: int = 128
+    pause_generation_mode: Literal["retract", "in_place"] = "retract"
+    openenv_env_url: str = "http://127.0.0.1:8003"
+    openenv_max_turns: int = 30
+    openenv_max_rollout_time_seconds: int = 3600
+    openenv_message_timeout_s: int = 1200
+    session_server_port: int = 30000
+    session_server_workers: int = 32
+    sglang_max_running_requests: int = 256
+    enable_mtp: bool = True
+
+    def __post_init__(self):
+        self.hardware = U.resolve_hardware(self)
+        if self.hardware != "B200" or self.num_gpus_per_node != U.NUM_GPUS_OF_HARDWARE[self.hardware]:
+            raise ValueError("This profile requires eight B200 GPUs per node.")
+        if self.num_nodes != 4 or self.layout not in ("1t3r", "2t2r", "3t1r"):
+            raise ValueError("The placement sweep requires exactly four whole nodes.")
+        if self.cleanup_existing_processes or not self.external_ray:
+            raise ValueError("This recipe requires external Ray and disables broad process cleanup.")
+        if self.rollout_batch_size * self.n_samples_per_prompt != self.global_batch_size:
+            raise ValueError("rollout_batch_size * n_samples_per_prompt must equal global_batch_size.")
+        if min(self.num_rollout, self.save_interval, self.global_batch_size, self.n_samples_per_prompt) <= 0:
+            raise ValueError("Step, checkpoint, and batch budgets must be positive.")
+        if self.async_max_concurrent_samples < self.n_samples_per_prompt:
+            raise ValueError("Async concurrency must admit at least one complete GRPO group.")
+        self.prompt_data = self.prompt_data or f"{self.output_dir}/{self.run_id}/data/train.prompts.jsonl"
+        self.host_map = self.host_map or f"{self.output_dir}/{self.run_id}/inventory/role-host-map.json"
+        self.placement_record_path = (
+            self.placement_record_path or f"{self.output_dir}/{self.run_id}/inventory/ray-placement.json"
+        )
+
+    @property
+    def trainer_nodes(self) -> int:
+        return int(self.layout[0])
+
+
+def _checkpoint_args(args: ScriptArgs) -> str:
+    checkpoint = f"{args.output_dir}/{args.run_id}/checkpoints"
+    return (
+        f"--hf-checkpoint {shlex.quote(args.model_dir + '/' + args.model_name)} "
+        f"--ref-load {shlex.quote(args.model_dir + '/' + args.model_name + '_torch_dist')} "
+        f"--load {shlex.quote(args.load_from or checkpoint)} --save {shlex.quote(checkpoint)} "
+        f"--save-interval {args.save_interval} "
+    )
+
+
+def _rollout_args(args: ScriptArgs) -> str:
+    asynchronous = (
+        f"--fully-async --pause-generation-mode {args.pause_generation_mode} "
+        f"--async-max-concurrent-samples {args.async_max_concurrent_samples} --max-weight-staleness 1 "
+        if args.execution == "async"
+        else ""
+    )
+    return (
+        asynchronous + "--rollout-submission-granularity sample "
+        f"--prompt-data {shlex.quote(args.prompt_data)} --input-key prompt --apply-chat-template "
+        f"--num-rollout {args.num_rollout} --rollout-batch-size {args.rollout_batch_size} "
+        f"--n-samples-per-prompt {args.n_samples_per_prompt} --global-batch-size {args.global_batch_size} "
+        f"--num-steps-per-rollout 1 --max-seq-len {args.max_seq_len} "
+        f"--rollout-max-response-len {args.rollout_max_response_len} --rollout-temperature 1 "
+        f"--seed {args.seed} --balance-data "
+    )
+
+
+def _performance_args(args: ScriptArgs) -> str:
+    return (
+        "--tensor-model-parallel-size 1 --sequence-parallel --pipeline-model-parallel-size 1 "
+        "--context-parallel-size 1 --expert-model-parallel-size 8 --expert-tensor-parallel-size 1 "
+        "--recompute-granularity full --recompute-method uniform --recompute-num-layers 1 "
+        f"--use-dynamic-batch-size --max-tokens-per-gpu {args.max_tokens_per_gpu} "
+        "--attention-dropout 0.0 --hidden-dropout 0.0 --accumulate-allreduce-grads-in-fp32 "
+        "--attention-softmax-in-fp32 --attention-backend flash --moe-token-dispatcher-type flex "
+    )
+
+
+def _algorithm_args() -> str:
+    return (
+        "--advantage-estimator grpo --use-kl-loss --kl-loss-coef 0.00 --kl-loss-type low_var_kl "
+        "--entropy-coef 0.00 --eps-clip 0.2 --eps-clip-high 0.28 "
+        "--optimizer adam --lr 1e-6 --lr-decay-style constant --weight-decay 0.1 "
+        "--adam-beta1 0.9 --adam-beta2 0.98 --optimizer-cpu-offload "
+        "--overlap-cpu-optimizer-d2h-h2d --use-precision-aware-optimizer "
+    )
+
+
+def _sglang_args(args: ScriptArgs) -> str:
+    mtp = (
+        "--sglang-speculative-algorithm EAGLE --sglang-speculative-num-steps 2 "
+        "--sglang-speculative-eagle-topk 1 --sglang-speculative-num-draft-tokens 3 "
+        "--sglang-mamba-scheduler-strategy extra_buffer "
+        "--enable-mtp-training --mtp-num-layers 1 --mtp-loss-scaling-factor 0.2 "
+        if args.enable_mtp
+        else ""
+    )
+    return (
+        "--rollout-num-gpus-per-engine 8 --sglang-ep-size 8 --sglang-mem-fraction-static 0.7 "
+        "--sglang-cuda-graph-bs 1 2 4 8 16 24 32 40 48 56 64 72 80 88 96 104 112 120 128 "
+        f"--sglang-max-running-requests {args.sglang_max_running_requests} " + mtp
+    )
+
+
+def _agent_args(args: ScriptArgs) -> str:
+    return (
+        "--custom-generate-function-path miles.rollout.generate_hub.agentic_tool_call.generate "
+        "--custom-agent-function-path openenv_agent_function.run "
+        "--custom-rm-path openenv_generate.reward_func "
+        "--dynamic-sampling-filter-path miles.rollout.filter_hub.dynamic_sampling_filters.check_no_aborted "
+        "--tito-model qwen36 --use-session-server "
+        f"--session-server-port {args.session_server_port} --session-server-workers {args.session_server_workers} "
+    )
+
+
+def execute(args: ScriptArgs):
+    run_dir = f"{args.output_dir}/{args.run_id}"
+    placement_args = (
+        f"--actor-num-nodes {args.trainer_nodes} --actor-num-gpus-per-node 8 --num-gpus-per-node 8 "
+        f"--rollout-num-gpus {(4 - args.trainer_nodes) * 8} "
+        f"--placement-host-order-file {shlex.quote(args.host_map)} "
+        f"--placement-record-path {shlex.quote(args.placement_record_path)} "
+        "--update-weight-transfer-mode broadcast --update-weights-interval 1 "
+    )
+    evidence_args = (
+        f"--dump-details {shlex.quote(run_dir + '/dump_details')} "
+        "--use-miles-dashboard --dashboard-sglang-scrape-mode direct "
+    )
+    train_args = " ".join(
+        [
+            _checkpoint_args(args),
+            _rollout_args(args),
+            _performance_args(args),
+            _algorithm_args(),
+            _sglang_args(args),
+            _agent_args(args),
+            placement_args,
+            evidence_args,
+            U.get_default_wandb_args(__file__, run_id=args.run_id),
+        ]
+    )
+    openenv_dir = Path(U.repo_base_dir) / "examples/experimental/openenv"
+    extra_env_vars = {
+        "PYTHONPATH": str(openenv_dir),
+        "OPENENV_ENV_URL": args.openenv_env_url,
+        "OPENENV_MAX_TURNS": str(args.openenv_max_turns),
+        "OPENENV_MAX_ROLLOUT_TIME_SECONDS": str(args.openenv_max_rollout_time_seconds),
+        "OPENENV_MESSAGE_TIMEOUT_S": str(args.openenv_message_timeout_s),
+        "AGENT_MODEL_NAME": "model",
+        "SGLANG_ENABLE_SPEC_V2": "1" if args.enable_mtp else "0",
+        "TORCH_NCCL_TRACE_BUFFER_SIZE": "4096",
+        "TORCH_NCCL_DUMP_ON_TIMEOUT": "1",
+        "TORCH_NCCL_DEBUG_INFO_TEMP_FILE": run_dir + "/telemetry/nccl_trace",
+    }
+    U.execute_train(
+        train_args=train_args,
+        config=args,
+        num_gpus_per_node=8,
+        megatron_model_type=args.megatron_model_type,
+        megatron_path=args.megatron_path,
+        extra_env_vars=extra_env_vars,
+        train_script="train_async.py" if args.execution == "async" else "train.py",
+    )
+
+
+@U.dataclass_cli
+def main(args: ScriptArgs):
+    execute(args)
+
+
+if __name__ == "__main__":
+    typer.run(main)

+import copy
+import json
+
+import pytest
+
+from miles.ray.host_placement import (
+    load_host_map,
+    placement_bundles,
+    validate_observed_placement,
+    write_placement_record,
+)
+
+
+def _nodes(trainers, rotation):
+    order = [(i + rotation) % 4 for i in range(4)]
+    return [
+        dict(
+            ray_node_ip=f"10.0.0.{host + 1}",
+            hostname=f"node-{host}",
+            role="trainer" if i < trainers else "rollout",
+            gpu_uuids=[f"GPU-{host}-{g}" for g in range(8)],
+        )
+        for i, host in enumerate(order)
+    ]
+
+
+@pytest.mark.parametrize("trainers", [1, 2, 3])
+@pytest.mark.parametrize("rotation", [0, 1, 2, 3])
+def test_every_split_and_rotation_binds_whole_nodes_and_matches_gpu_uuids(tmp_path, trainers, rotation):
+    nodes = _nodes(trainers, rotation)
+    path = tmp_path / "hosts.json"
+    path.write_text(json.dumps(dict(schema_version=1, nodes=nodes)))
+    loaded = load_host_map(path, num_gpus=32, trainer_gpus=trainers * 8, gpus_per_node=8)
+    ray_nodes = [
+        dict(Alive=True, NodeManagerAddress=n["ray_node_ip"], Resources={"GPU": 8, "node:" + n["ray_node_ip"]: 1})
+        for n in reversed(nodes)
+    ]
+    bundles = placement_bundles(loaded, ray_nodes, gpus_per_node=8)
+    identities = []
+    for i, node in enumerate(nodes):
+        block = bundles[i * 8 : (i + 1) * 8]
+        assert all(bundle.get("node:" + node["ray_node_ip"]) == 0.01 for bundle in block)
+        identities.extend(
+            dict(
+                ray_node_ip=node["ray_node_ip"],
+                gpu_uuid=uuid,
+                gpu_id=g,
+                hostname=node["hostname"],
+                probe_actor_id=f"probe-{i}-{g}",
+            )
+            for g, uuid in enumerate(reversed(node["gpu_uuids"]))
+        )
+    records = validate_observed_placement(nodes, identities, gpus_per_node=8)
+    assert len([r for r in records if r["role"] == "trainer"]) == trainers * 8
+    assert len({r["gpu_uuid"] for r in records}) == 32
+    out = tmp_path / "placement.json"
+    write_placement_record(out, records, placement_group_id="owned-group")
+    assert json.loads(out.read_text())["bundles"] == records
+    with pytest.raises(FileExistsError):
+        write_placement_record(out, [], placement_group_id="later-group")
+    assert json.loads(out.read_text())["bundles"] == records
+
+
+@pytest.mark.parametrize("mutation", ["role", "uuid", "ip", "size"])
+def test_invalid_host_maps_fail_closed(tmp_path, mutation):
+    nodes = _nodes(2, 0)
+    if mutation == "role":
+        nodes[0]["role"] = "rollout"
+    elif mutation == "uuid":
+        nodes[1]["gpu_uuids"][0] = nodes[0]["gpu_uuids"][0]
+    elif mutation == "ip":
+        nodes[1]["ray_node_ip"] = nodes[0]["ray_node_ip"]
+    else:
+        nodes.pop()
+    path = tmp_path / "hosts.json"
+    path.write_text(json.dumps(dict(schema_version=1, nodes=nodes)))
+    with pytest.raises(ValueError):
+        load_host_map(path, num_gpus=32, trainer_gpus=16, gpus_per_node=8)
+
+
+def test_shared_ray_cluster_or_misplaced_gpu_is_rejected():
+    nodes = _nodes(2, 0)
+    ray_nodes = [
+        dict(Alive=True, NodeManagerAddress=n["ray_node_ip"], Resources={"GPU": 8, "node:" + n["ray_node_ip"]: 1})
+        for n in nodes
+    ]
+    extra = dict(Alive=True, NodeManagerAddress="10.0.0.9", Resources={"GPU": 8, "node:10.0.0.9": 1})
+    with pytest.raises(ValueError, match="exactly match"):
+        placement_bundles(nodes, ray_nodes + [extra], gpus_per_node=8)
+    identities = [dict(ray_node_ip=n["ray_node_ip"], gpu_uuid=g) for n in nodes for g in n["gpu_uuids"]]
+    for field, value in [("ray_node_ip", "10.0.0.9"), ("gpu_uuid", "GPU-unexpected")]:
+        bad = copy.deepcopy(identities)
+        bad[0][field] = value
+        with pytest.raises(ValueError):
+            validate_observed_placement(nodes, bad, gpus_per_node=8)

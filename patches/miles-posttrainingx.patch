+
+    actor = SimpleNamespace(release_pinned_weight_backups=AsyncMock())
+    await finish_training_resources(SimpleNamespace(release_pinned_backups_on_exit=False), actor, None)
+    actor.release_pinned_weight_backups.assert_not_awaited()
+    actor.release_pinned_weight_backups.side_effect = RuntimeError("release failed")
+    with pytest.raises(RuntimeError, match="release failed"):
+        await finish_training_resources(SimpleNamespace(release_pinned_backups_on_exit=True), actor, None)

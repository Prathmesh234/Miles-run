+    args.rollout_journal_dir = str(tmp_path / "failed-journal")
+    with pytest.raises(RuntimeError, match="accounting failed"):
+        cleanup.release_and_record(args, backuper, rank=3, policy_version=2)
+    kinds = {json.loads(p.read_text())["event"] for p in (tmp_path / "failed-journal").glob("*.json")}
+    assert kinds == {"training_host_cleanup_started", "training_host_cleanup_failed"}
+
+
+@pytest.mark.asyncio
+async def test_driver_host_release_is_opt_in_and_failure_propagates():
+    from unittest.mock import AsyncMock

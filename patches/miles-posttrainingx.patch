new file mode 100644
index 000000000..f31a56a87
--- /dev/null
+++ b/examples/experimental/openenv/posttrainingx_local_agent.py
@@ -0,0 +1,51 @@
+"""Clean local-file OpenEnv transport; Miles retains sampling and token tracing.
+
+No Verifiers upgrade, re-tokenization, host shell, or post-grading policy action.
+Operational errors stop this qualification run instead of becoming reward zero.
+"""
+import math
+
+from openenv_agent_function import multi_turn, run_for_training, _shared_run_body
+from posttrainingx_openenv_client import Action, LocalOpenEnvClient
+
+
+async def run_episode(policy, model_name, messages, request_kwargs, metadata):
+    return await multi_turn(
+        {'env': LocalOpenEnvClient, 'action': Action}, policy, model_name,
+        messages, request_kwargs, metadata, run_body=_shared_run_body,
+    )
+
+
+async def run(base_url, prompt, request_kwargs=None, metadata=None, **kwargs):
+    result = await run_for_training(base_url, prompt, request_kwargs, metadata, run_episode)
+    return result if result is not None else {'reward': None, 'exit_status': 'operational_error'}
+
+
+async def reward_func(args, samples, **kwargs):
+    def reward(sample):
+        value = sample.metadata.get('reward')
+        if value not in (0.0, 1.0) or sample.metadata.get('exit_status') not in ('completed', 'timeout'):
+            raise RuntimeError('Local environment returned no valid verdict; stopping rather than fabricating a negative reward.')
+        return float(value)
+    return [reward(s) for s in samples] if isinstance(samples, list) else reward(samples)
+
+
+def validate_group(args, samples, **kwargs):
+    from miles.rollout.filter_hub.base_types import DynamicFilterOutput
+    from miles.utils.types import Sample
+    rows = [s for item in samples for s in (item if isinstance(item, list) else [item])]
+    if len(rows) != args.n_samples_per_prompt or len({s.group_index for s in rows}) != 1:
+        raise RuntimeError('GRPO group cardinality or identity mismatch.')
+    for sample in rows:
+        if sample.status == Sample.Status.ABORTED:
+            raise RuntimeError('Aborted trajectory in synchronous qualification; preserving failure instead of silently retrying.')
+        if not sample.tokens or not all(type(t) is int and t >= 0 for t in sample.tokens):
+            raise RuntimeError('Missing native sampled token IDs.')
+        if (sample.rollout_log_probs is None or len(sample.rollout_log_probs) != sample.response_length
+                or not all(math.isfinite(p) for p in sample.rollout_log_probs)):
+            raise RuntimeError('Native response token/logprob accounting mismatch.')
+        if sample.loss_mask is None or len(sample.loss_mask) != sample.response_length or not any(sample.loss_mask):
+            raise RuntimeError('Missing native response loss mask.')
+        if sample.multimodal_inputs or sample.multimodal_train_inputs:
+            raise RuntimeError('Text-only recipe received multimodal inputs.')
+    return DynamicFilterOutput(keep=True)
diff --git a/examples/experimental/openenv/posttrainingx_openenv_client.py b/examples/experimental/openenv/posttrainingx_openenv_client.py
new file mode 100644
index 000000000..db221511a
--- /dev/null
+++ b/examples/experimental/openenv/posttrainingx_openenv_client.py
@@ -0,0 +1,52 @@
+"""Small OpenEnv WS client; no OpenEnv/OpenAI dependency upgrade in GPU image.
+
+Carries only environment actions/observations. Policy sampling, renderer, token
+IDs and logprobs stay in the existing Miles session server and agent loop.
+"""
+import asyncio
+import json
+from types import SimpleNamespace
+from urllib.parse import urlsplit, urlunsplit
+
+
+class Action(SimpleNamespace):
+    pass
+
+
+class LocalOpenEnvClient:
+    def __init__(self, base_url, message_timeout_s=360):
+        url = urlsplit(base_url)
+        if url.scheme not in ('http', 'https') or url.username or url.password or url.query or url.fragment:
+            raise ValueError('Expected a plain configured environment endpoint.')
+        self.url = urlunsplit(('wss' if url.scheme == 'https' else 'ws', url.netloc, url.path.rstrip('/') + '/ws', '', ''))
+        self.timeout = message_timeout_s
+        self.ws = None
+
+    async def __aenter__(self):
+        from websockets.asyncio.client import connect
+        self.ws = await connect(self.url, proxy=None, open_timeout=20, max_size=20*1024**2)
+        return self
+
+    async def __aexit__(self, *exc):
+        if self.ws is not None:
+            try:
+                await self.ws.send(json.dumps({'type': 'close'}))
+            finally:
+                await self.ws.close()
+
+    async def exchange(self, operation, data):
+        await self.ws.send(json.dumps({'type': operation, 'data': data}))
+        reply = json.loads(await asyncio.wait_for(self.ws.recv(), timeout=self.timeout))
+        if reply.get('type') == 'error':
+            error = reply.get('data', {})
+            raise RuntimeError('Environment error: ' + str(error.get('code', 'UNKNOWN')))
+        value = reply['data']
+        observation = SimpleNamespace(**value.get('observation', {}))
+        return SimpleNamespace(observation=observation, reward=value.get('reward'), done=value.get('done'),
+                               metadata=value.get('metadata'))
+
+    async def reset(self, **kwargs):
+        return await self.exchange('reset', kwargs)
+
+    async def step(self, action):
+        return await self.exchange('step', vars(action))

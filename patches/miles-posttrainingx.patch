new file mode 100644
index 000000000..14fed5558
--- /dev/null
+++ b/miles/rollout/trajectory_journal.py
@@ -0,0 +1,101 @@
+"""Opt-in durable trajectory identities and decisions, independent of dashboards.
+
+The journal contains private training evidence, never a policy-visible mount.
+Each event is atomic and immutable. Writer failures propagate to the caller;
+the journal is not a replacement for optimizer or checkpoint verification.
+"""
+
+import contextvars
+import datetime
+import hashlib
+import json
+import os
+import shutil
+import socket
+import tempfile
+import time
+import uuid
+from contextlib import contextmanager
+from pathlib import Path
+
+ATTEMPT_KEY = "_miles_journal_attempt_id"
+_ACTIVE_SAMPLE = contextvars.ContextVar("miles_journal_sample", default=None)
+
+
+def _samples(group):
+    return [sample for item in group for sample in (item if isinstance(item, list) else [item])]
+
+
+def _write(directory, event, payload):
+    target = Path(directory)
+    if any(path.is_symlink() for path in (target, *target.parents)):
+        raise ValueError("Journal paths must not contain symlinks.")
+    target.mkdir(parents=True, exist_ok=True)
+    if shutil.disk_usage(target).free < 256 * 1024**2:
+        raise RuntimeError("Journal requires a 256 MiB free-space reserve.")
+    record = dict(schema_version=1, event=event, time=datetime.datetime.now(datetime.timezone.utc).isoformat(), monotonic_s=time.monotonic(), hostname=socket.gethostname(), pid=os.getpid(), slurm_job_id=os.environ.get("SLURM_JOB_ID"), **payload)
+    data = json.dumps(record, sort_keys=True, allow_nan=False).encode()
+    digest = hashlib.sha256(data).hexdigest()
+    name = f"{event}-{uuid.uuid4().hex}-{digest}.json"
+    fd, temporary = tempfile.mkstemp(dir=target, prefix=".event-")
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.link(temporary, target / name)
+        parent = os.open(target, os.O_RDONLY)
+        try:
+            os.fsync(parent)
+        finally:
+            os.close(parent)
+    finally:
+        os.unlink(temporary)
+    return name
+
+
+def record_group(args, event, group, *, native=False, **context):
+    directory = getattr(args, "rollout_journal_dir", None)
+    if not directory:
+        return
+    rows = []
+    for sample in _samples(group):
+        row = dict(sample_index=sample.index, group_index=sample.group_index, attempt_id=sample.metadata.get(ATTEMPT_KEY), status=sample.status.value, task_id=sample.metadata.get("task_id"), weight_versions=sample.weight_versions, environment_attempts=sample.metadata.get("posttrainingx_environment_attempts", []))
+        if native:
+            row.update(tokens=sample.tokens, rollout_log_probs=sample.rollout_log_probs, loss_mask=sample.loss_mask, response_length=sample.response_length, reward=sample.reward, spec_info=sample.spec_info.to_dict(), non_generation_time=sample.non_generation_time)
+        rows.append(row)
+    _write(directory, event, dict(samples=rows, **context))
+
+
+def begin_group(args, group):
+    if not getattr(args, "rollout_journal_dir", None):
+        return
+    samples = _samples(group)
+    if any(sample.index is None or sample.group_index is None for sample in samples):
+        raise ValueError("Durable journal requires native sample/group identities.")
+    attempt = uuid.uuid4().hex
+    for sample in samples:
+        sample.metadata = dict(sample.metadata, **{ATTEMPT_KEY: attempt})
+    record_group(args, "group_submitted", group)
+
+
+@contextmanager
+def sample_context(args, sample, *, evaluation=False):
+    directory = None if evaluation else getattr(args, "rollout_journal_dir", None)
+    context = None if not directory else dict(directory=directory, sample_index=sample.index, group_index=sample.group_index, attempt_id=sample.metadata.get(ATTEMPT_KEY))
+    token = _ACTIVE_SAMPLE.set(context)
+    try:
+        yield
+    finally:
+        _ACTIVE_SAMPLE.reset(token)
+
+
+def record_environment_attempt(episode_id, task_id):
+    """Record the controller identity as the environment body exits, even on cancellation.
+
+    Controller-side events independently prove grading isolation and cleanup.
+    """
+    context = _ACTIVE_SAMPLE.get()
+    if context is not None:
+        payload = {key: value for key, value in context.items() if key != "directory"}
+        _write(context["directory"], "environment_attempt", dict(payload, episode_id=episode_id, task_id=task_id))

From 7b212b00b3a8881b463bc1bf630a79194ef837c4 Mon Sep 17 00:00:00 2001
From: Prathmesh234 <ppbhatt500@gmail.com>
Date: Wed, 2 Sep 2026 12:26:29 -0700
Subject: [PATCH] Reject linked and oversized task archives before Docker
 upload

---
 .../server/tbench2_env_environment.py         | 42 ++++++++++++++++--
 tests/envs/test_tbench2_env.py                | 43 +++++++++++++++++++
 2 files changed, 82 insertions(+), 3 deletions(-)

diff --git a/envs/tbench2_env/server/tbench2_env_environment.py b/envs/tbench2_env/server/tbench2_env_environment.py
index f731b11..87722ca 100644
--- a/envs/tbench2_env/server/tbench2_env_environment.py
+++ b/envs/tbench2_env/server/tbench2_env_environment.py
@@ -14,6 +14,7 @@ import os
 import re
 import shlex
 import shutil
+import stat
 import tarfile
 import threading
 import sys
@@ -48,6 +49,10 @@ _CAMEL_IMPORT_ERROR: Exception | None = None
 _VERIFY_TESTS_DIR = "/tests"
 _VERIFIER_LOG_DIR = "/logs/verifier"
 
+# Bound server-side staging; oversized or linked task assets need an explicit
+# reviewed packaging change, never a fallback that copies host files.
+_MAX_TASK_ARCHIVE_BYTES = 256 * 1024 * 1024
+
 
 def _hard_remove(path: str) -> None:
     """Remove whatever is at *path* — file, symlink, or directory tree.
@@ -870,22 +875,53 @@ class Tbench2DockerEnvironment(
         """
         if self._container is None:
             raise RuntimeError("Container not started")
+        if src_dir.is_symlink() or not src_dir.is_dir():
+            raise ValueError("Task archive source must be a real directory")
+        src_dir = src_dir.resolve()
 
         # Create tar archive in memory (recursive=False: rglob already yields
         # every descendant, so per-entry recursion would duplicate members —
         # and would re-add excluded subtrees through their parents).
         tar_stream = io.BytesIO()
         with tarfile.open(fileobj=tar_stream, mode="w") as tar:
-            for item in src_dir.rglob("*"):
+            for item in sorted(src_dir.rglob("*")):
                 rel = item.relative_to(src_dir)
                 if rel.parts and rel.parts[0] in exclude_top:
                     continue
-                tar.add(str(item), arcname=str(rel), recursive=False)
+                before = item.lstat()
+                if stat.S_ISLNK(before.st_mode) or not (
+                    stat.S_ISREG(before.st_mode) or stat.S_ISDIR(before.st_mode)
+                ):
+                    raise ValueError(f"Linked or special task asset rejected: {rel}")
+                if stat.S_ISREG(before.st_mode) and before.st_nlink != 1:
+                    raise ValueError(f"Hard-linked task asset rejected: {rel}")
+                if not item.resolve().is_relative_to(src_dir):
+                    raise ValueError(f"Task asset escapes source directory: {rel}")
+                info = tar.gettarinfo(str(item), arcname=str(rel))
+                # Reserve metadata/padding space, including the final tar block.
+                if tar_stream.tell() + info.size + 16384 > _MAX_TASK_ARCHIVE_BYTES:
+                    raise ValueError("Task archive exceeds staging byte limit")
+                if info.isdir():
+                    tar.addfile(info)
+                else:
+                    # Do not follow a file swapped to a symlink after lstat.
+                    fd = os.open(item, os.O_RDONLY | os.O_NOFOLLOW)
+                    with os.fdopen(fd, "rb") as source:
+                        current = os.fstat(source.fileno())
+                        if (
+                            not stat.S_ISREG(current.st_mode)
+                            or current.st_nlink != 1
+                            or (current.st_dev, current.st_ino, current.st_size)
+                            != (before.st_dev, before.st_ino, before.st_size)
+                        ):
+                            raise ValueError(f"Task asset changed during staging: {rel}")
+                        tar.addfile(info, source)
 
         tar_stream.seek(0)
 
         # Copy to container
-        self._container.put_archive(dest_path, tar_stream.getvalue())
+        if not self._container.put_archive(dest_path, tar_stream.getvalue()):
+            raise RuntimeError("Docker rejected task archive upload")
 
     def _resolve_workdir(self, image: Any, task_dir: Path) -> str:
         """The dir agent commands and scoring run in: the task image's own
diff --git a/tests/envs/test_tbench2_env.py b/tests/envs/test_tbench2_env.py
index d9ce71d..84019e9 100644
--- a/tests/envs/test_tbench2_env.py
+++ b/tests/envs/test_tbench2_env.py
@@ -402,6 +402,49 @@ def test_docker_copy_excludes_verifier_assets(tmp_path: Path):
     assert len(names) == len(set(names))  # recursive=False: no duplicates
 
 
+@pytest.mark.parametrize("kind", ["symlink", "directory_symlink", "hardlink", "fifo"])
+def test_docker_copy_rejects_linked_and_special_assets(tmp_path: Path, kind: str):
+    task = _make_task_dir(tmp_path)
+    asset = task / "visible-alias"
+    secret = task / "tests" / "test_outputs.py"
+    if kind == "symlink":
+        asset.symlink_to(secret)
+    elif kind == "directory_symlink":
+        asset.symlink_to(task / "tests", target_is_directory=True)
+    elif kind == "hardlink":
+        asset.hardlink_to(secret)
+    else:
+        __import__("os").mkfifo(asset)
+    env = Tbench2DockerEnvironment()
+    container = _FakeContainer()
+    env._container = container
+    with pytest.raises(ValueError, match="asset rejected"):
+        env._copy_dir_to_container(task, "/task", exclude_top=("solution", "tests"))
+    assert not container.events
+
+
+def test_docker_copy_enforces_byte_budget_before_upload(tmp_path: Path, monkeypatch):
+    task = _make_task_dir(tmp_path)
+    env = Tbench2DockerEnvironment()
+    container = _FakeContainer()
+    env._container = container
+    monkeypatch.setattr(sys.modules[Tbench2DockerEnvironment.__module__], "_MAX_TASK_ARCHIVE_BYTES", 16384)
+    (task / "large-asset").write_bytes(b"x" * 16384)
+    with pytest.raises(ValueError, match="staging byte limit"):
+        env._copy_dir_to_container(task, "/task", exclude_top=("solution", "tests"))
+    assert not container.events
+
+
+def test_docker_copy_rejects_failed_docker_upload(tmp_path: Path, monkeypatch):
+    task = _make_task_dir(tmp_path)
+    env = Tbench2DockerEnvironment()
+    container = _FakeContainer()
+    env._container = container
+    monkeypatch.setattr(container, "put_archive", lambda *args: False)
+    with pytest.raises(RuntimeError, match="rejected task archive upload"):
+        env._copy_dir_to_container(task, "/task", exclude_top=("solution", "tests"))
+
+
 def test_evaluate_docker_missing_verdict_raises_not_zero(tmp_path: Path):
     """Docker-mode twin of the local missing-verdict case: an empty reward
     marker errors out (with cleanup) instead of scoring 0.0."""
